# 部署或换机时的模板：复制成 .env 再按环境修改（Copy-Item .env.example .env）
# 左侧是宿主机端口，容器内端口固定（MySQL 3306 / API 8080 / Web 80）
MYSQL_PORT=3306
API_PORT=8080
WEB_PORT=5173

# 数据库 root 密码：部署必须换成强密码，且不要含空格、美元符号、引号、反斜杠等特殊字符
MYSQL_ROOT_PASSWORD=change-me-strong-password

# 容器 MySQL 绑定到宿主机的哪张网卡：127.0.0.1 = 只有本机能连（安全默认）；
# 0.0.0.0 = 局域网或公网可连，除非确有必要否则不要开
MYSQL_BIND=127.0.0.1

# ---------- 大模型（可选增强，不配就全系统离线走规则引擎）----------
# 只支持 OpenAI 兼容的 POST {AI_BASE_URL}/chat/completions，且该模型要支持 response_format={"type":"json_object"}。
# AI_BASE_URL 要带 /v1：OpenAI https://api.openai.com/v1 · DeepSeek https://api.deepseek.com/v1 ·
#   阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1 · 本地 Ollama http://host.docker.internal:11434/v1（key 随便填）。
# 本机自训练模型（Qwen2.5-7B + LoRA）走 LLaMA-Factory 的 api 模式：先双击仓库根目录的 启动Agent.bat，
# 再改成下面三行（容器里访问宿主机要用 host.docker.internal）：
#   AI_ENABLED=true
#   AI_BASE_URL=http://host.docker.internal:8000/v1
#   AI_MODEL=qwen2.5-7b-lora
#   AI_API_KEY=not-needed          ← api 模式未开鉴权，但留空会被判成「未配置大模型」
#   AI_TIMEOUT_SECONDS=300         ← 7B 4-bit 出一份诊断约 80 秒，默认 20 秒必定读超时
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_SECONDS=20

# 公司运行诊断 Agent（老总端）专属模型（可选）：本地 sft17_exec 专用 adapter，与个人诊断分端口部署。
# 先再开一个窗口跑公司诊断模型（tools\agent\start-agent.ps1 -Exec，默认端口 8002），再取消注释：
#   AI_EXEC_BASE_URL=http://host.docker.internal:8002/v1
#   AI_EXEC_MODEL=qwen2.5-3b-exec
#   AI_EXEC_TIMEOUT_SECONDS=300    ← 3B 4-bit 出一份公司诊断约 100-250 秒
# 三个值都不配时自动回落上面共用配置，行为与不配置时完全一致。

# ---------- 登录令牌签名密钥 ----------
# 后端用它给登录令牌签名（AuthFilter 校验），客户端改不动令牌内容。
# 留空会用代码里的公开默认值 —— 知道默认值的人可以自己签一个管理员令牌，
# 所以对外演示或部署前必须换成随机串（例如 32 字节十六进制）。换掉后所有人需重新登录。
AUTH_SECRET=
