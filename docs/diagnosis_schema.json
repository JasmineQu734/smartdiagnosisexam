{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://train.local/schemas/diagnosis_schema.json",
  "title": "Agent 诊断输出契约（个人诊断 / 公司运行诊断）",
  "description": "本文件由现有硬编码实现反推得到，是前端已经依赖的输出契约。个人口径来自 dataset_meta[personal.diagnosis.core]（db/init/004_seed_refine.sql:24），公司口径来自 dataset_meta[exec.diagnosis]（db/init/003_seed_datasets.sql:257），运行时由 PersonaController / CompanyController 补写诊断编号、时间、证据条数等字段。改造为大模型输出后，字段名、类型与枚举取值必须保持一致，前端不做改动。",
  "definitions": {
    "source": {
      "type": "string",
      "enum": ["rule", "model"],
      "description": "结论来源。rule=规则引擎或兜底，model=大模型。替换实现不得改变该字段形状。"
    },
    "severity": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "description": "影响等级，前端按此映射标签样式（HIGH=bad / MEDIUM=warn / LOW=ok），不得新增取值。"
    },
    "personalVerdict": {
      "type": "object",
      "required": ["headline", "reasons"],
      "properties": {
        "headline": { "type": "string", "description": "一句话结论，显示在诊断卡片顶部" },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "结论依据逐条列出，前端逐条渲染为无序列表" }
      }
    },
    "execVerdict": {
      "type": "object",
      "required": ["cause", "label", "headline", "evidence"],
      "properties": {
        "cause": { "type": "string", "enum": ["MIXED", "TALENT_GAP", "SKILL_GAP"], "description": "主因归类。MIXED=人才缺失与技能不足并存；TALENT_GAP=以缺人为主；SKILL_GAP=以在岗技能不足为主。" },
        "label": { "type": "string", "description": "主因的自然语言表述" },
        "headline": { "type": "string", "description": "一句话诊断结论" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "库中种子已有的归因置信度，前端未读取，保留以兼容既有数据" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "证据条目，前端逐条渲染" }
      }
    },
    "skillGap": {
      "type": "object",
      "required": ["skill", "current", "required", "future", "severity", "priority", "impact", "action"],
      "properties": {
        "skill": { "type": "string", "description": "技能名，同时是前端 v-for 的 key，同一响应内不得重复" },
        "current": { "type": "integer", "minimum": 1, "maximum": 5, "description": "当前等级，前端渲染为 L{current}" },
        "required": { "type": "integer", "minimum": 1, "maximum": 5, "description": "岗位要求等级" },
        "future": { "type": "integer", "minimum": 1, "maximum": 5, "description": "未来需求等级" },
        "severity": { "$ref": "#/definitions/severity" },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3"], "description": "优先级标签，按严重度排序展示" },
        "impact": { "type": "string", "description": "缺口造成的业务影响" },
        "action": { "type": "string", "description": "怎么做，可含箭头串（如：补微课 → 带教 2 次 → 模拟考 ≥80 分）" }
      }
    },
    "planStep": {
      "type": "object",
      "required": ["step", "kind", "title", "target_skill", "to_level", "due_at", "reason"],
      "properties": {
        "step": { "type": "integer", "minimum": 1, "description": "步骤序号，前端显示为第 N 步" },
        "kind": { "type": "string", "enum": ["课程", "带教", "模拟考"], "description": "步骤类型，前端按此着色，不得新增取值（新增需同步前端 kindClass 映射）" },
        "title": { "type": "string", "description": "动作标题" },
        "target_skill": { "type": "string", "description": "针对的技能，应与 gaps[].skill 对应" },
        "to_level": { "type": "string", "pattern": "^L[1-5]$", "description": "目标等级，形如 L2" },
        "due_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "截止日期（YYYY-MM-DD）" },
        "reason": { "type": "string", "description": "为什么先做这一步，须能回指差距清单或数据点" }
      }
    },
    "compoundStage": {
      "type": "object",
      "required": ["phase", "focus", "skills", "milestone"],
      "properties": {
        "phase": { "type": "string", "description": "阶段名，含时间范围，如：第 1 阶段 · 0-2 个月" },
        "focus": { "type": "string", "description": "阶段聚焦点" },
        "skills": { "type": "string", "description": "学什么" },
        "milestone": { "type": "string", "description": "达标标志" }
      }
    },
    "compoundPath": {
      "type": "object",
      "required": ["title", "why", "stages", "benefit"],
      "properties": {
        "title": { "type": "string", "description": "复合型人才路线标题，同时作为该区块小标题" },
        "why": { "type": "string", "description": "为什么走这条路" },
        "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/compoundStage" } },
        "benefit": { "type": "string", "description": "收益，含可量化金额或比例" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["title", "impact", "evidence"],
      "properties": {
        "title": { "type": "string", "description": "问题标题，同时是前端 v-for 的 key，同一响应内不得重复" },
        "impact": { "type": "string", "description": "影响" },
        "evidence": { "type": "string", "description": "依据，须能回指具体数据点" }
      }
    },
    "action": {
      "type": "object",
      "required": ["priority", "owner", "action", "cost_impact", "expected"],
      "properties": {
        "priority": { "$ref": "#/definitions/severity" },
        "owner": { "type": "string", "description": "责任方" },
        "action": { "type": "string", "description": "措施内容" },
        "cost_impact": { "type": "string", "description": "成本影响，如 +¥16 万招聘成本 或 0" },
        "expected": { "type": "string", "description": "预期效果" }
      }
    },
    "costSummary": {
      "type": "object",
      "required": ["current_total", "optimized_total", "saving", "note"],
      "properties": {
        "current_total": { "type": "number", "description": "当前用人成本（元）" },
        "optimized_total": { "type": "number", "description": "优化后测算（元）" },
        "saving": { "type": "number", "description": "预计节省（元）" },
        "note": { "type": "string", "description": "口径说明" }
      }
    }
  },
  "schemas": {
    "personalDiagnosis": {
      "title": "POST /api/v1/personal/agent-diagnose 的 data",
      "type": "object",
      "required": ["diagnosis_id", "ran_at", "source_label", "evidence_count", "confidence", "need_human_confirm", "summary", "verdict", "gaps", "plan", "compound_path", "updated_modules"],
      "properties": {
        "diagnosis_id": { "type": "string", "pattern": "^DIA-[0-9]{8}-[0-9]{3}$", "description": "诊断编号，后端生成" },
        "ran_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$", "description": "运行时间" },
        "source": { "$ref": "#/definitions/source" },
        "source_label": { "type": "string", "description": "来源展示文案，如：个人学习 Agent（规则引擎 v1 · 实时计算）" },
        "evidence_count": { "type": "integer", "minimum": 0, "description": "证据条数" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "置信度，前端按百分比渲染" },
        "need_human_confirm": { "type": "boolean", "description": "是否需人工确认后生效" },
        "summary": { "type": "string", "description": "总述段落" },
        "verdict": { "$ref": "#/definitions/personalVerdict" },
        "gaps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/skillGap" }, "description": "差距清单（按优先级）" },
        "plan": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/planStep" }, "description": "学习路径（实时生成）" },
        "compound_path": { "$ref": "#/definitions/compoundPath" },
        "updated_modules": { "type": "array", "items": { "type": "string" }, "description": "本次诊断已同步的板块" },
        "fallback_note": { "type": "string", "description": "仅在大模型失败回退时出现，说明回退原因" },
        "unverified_numbers": { "type": "array", "items": { "type": "string" }, "description": "结论正文里出现、但事实清单中查不到出处的数字（软校验留痕，不拦截结论）；出现时 confidence 会被压到 0.6 以内" }
      }
    },
    "execDiagnosis": {
      "title": "POST /api/v1/exec/agent-diagnose 的 data",
      "type": "object",
      "required": ["diagnosis_id", "ran_at", "source_label", "confidence", "need_human_confirm", "inputs", "summary", "evidence_count", "verdict", "findings", "actions", "cost_summary", "updated_modules"],
      "properties": {
        "diagnosis_id": { "type": "string", "pattern": "^EXE-DIA-[0-9]{8}-[0-9]{3}$", "description": "诊断编号，后端生成" },
        "ran_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$", "description": "运行时间" },
        "generated_at": { "type": "string", "description": "基线口径生成时间，沿用库中现值" },
        "source": { "$ref": "#/definitions/source" },
        "source_label": { "type": "string", "description": "来源展示文案，如：公司运行诊断 Agent（规则引擎 v1 · 实时计算）" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "need_human_confirm": { "type": "boolean", "description": "恒为 true：结论须老总确认后才执行" },
        "live_reports": { "type": "integer", "minimum": 0, "description": "运行时刻系统内实操报告份数" },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "本次读取的输入类别，前端用 join 渲染为顿号串" },
        "summary": { "type": "string", "description": "总述段落" },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "verdict": { "$ref": "#/definitions/execVerdict" },
        "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/finding" }, "description": "问题清单" },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/action" }, "description": "建议措施（需人工确认后执行）" },
        "cost_summary": { "$ref": "#/definitions/costSummary" },
        "updated_modules": { "type": "array", "items": { "type": "string" } },
        "fallback_note": { "type": "string", "description": "仅在大模型失败回退时出现" },
        "unverified_numbers": { "type": "array", "items": { "type": "string" }, "description": "结论正文里出现、但事实清单中查不到出处的数字（软校验留痕，不拦截结论）；出现时 confidence 会被压到 0.6 以内" }
      }
    }
  }
}
